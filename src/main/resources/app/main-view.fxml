<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<?import javafx.scene.control.Label?>
<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="app.MainController"
           prefWidth="960.0"
           prefHeight="600.0"
           stylesheets="@town-view.css"
           styleClass="town-root">

    <AnchorPane prefWidth="960.0"
                prefHeight="600.0"
                pickOnBounds="false">

        <!-- Wilds: left-side path and tall grass -->
        <StackPane layoutX="0.0"
                   layoutY="0.0"
                   prefWidth="275.0"
                   prefHeight="600.0"
                   pickOnBounds="true"
                   onMouseClicked="#handleBattle"
                   styleClass="map-hotspot">

            <Button text="Explore the Wilds"
                    translateY="-120.0"
                    mouseTransparent="true"
                    focusTraversable="false"
                    styleClass="map-action-button"/>
        </StackPane>

        <!-- Arena: top-center colosseum -->
        <StackPane layoutX="270.0"
                   layoutY="0.0"
                   prefWidth="410.0"
                   prefHeight="220.0"
                   pickOnBounds="true"
                   onMouseClicked="#handleArena"
                   styleClass="map-hotspot">

            <Button text="Battle the Arena!!"
                    mouseTransparent="true"
                    focusTraversable="false"
                    styleClass="map-action-button"/>
        </StackPane>

        <!-- CatDex: purple book building -->
        <StackPane layoutX="675.0"
                   layoutY="45.0"
                   prefWidth="225.0"
                   prefHeight="215.0"
                   pickOnBounds="true"
                   onMouseClicked="#handleCatDex"
                   styleClass="map-hotspot">

            <Button text="View CatDex"
                    mouseTransparent="true"
                    focusTraversable="false"
                    styleClass="map-action-button"/>
        </StackPane>

        <!-- Trader: lower-left market -->
        <StackPane layoutX="85.0"
                   layoutY="365.0"
                   prefWidth="315.0"
                   prefHeight="190.0"
                   pickOnBounds="true"
                   onMouseClicked="#handleTrader"
                   styleClass="map-hotspot">

            <Button text="Visit the Trader"
                    mouseTransparent="true"
                    focusTraversable="false"
                    styleClass="map-action-button"/>
        </StackPane>

        <!-- Storage: lower-right house -->
        <StackPane layoutX="650.0"
                   layoutY="315.0"
                   prefWidth="235.0"
                   prefHeight="220.0"
                   pickOnBounds="true"
                   onMouseClicked="#handleStorage"
                   styleClass="map-hotspot">

            <Button text="View Storage"
                    mouseTransparent="true"
                    focusTraversable="false"
                    styleClass="map-action-button"/>
        </StackPane>

        <!-- Utility navigation -->
        <HBox layoutX="300.0"
              layoutY="548.0"
              prefHeight="42.0"
              alignment="CENTER"
              spacing="18"
              styleClass="town-hud">

            <Label fx:id="currencyLabel"
                   text="Coins: 0"
                   styleClass="hud-label"/>

            <Button text="View Party"
                    onAction="#handleParty"
                    focusTraversable="false"
                    styleClass="hud-button"/>

            <Button text="Options"
                    onAction="#handleOptions"
                    focusTraversable="false"
                    styleClass="hud-button"/>

        </HBox>

    </AnchorPane>

</StackPane>