<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="app.MainController"
      alignment="CENTER"
      spacing="16">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Clash of Claws!!!"
           style="-fx-font-size: 64px; -fx-font-weight: bold;"/>

    <Label text="Project is up and running!"/>

    <Button
            prefWidth="220.0"
            prefHeight="46.0"
            text="Enter Battle"
            onAction="#handleBattle"
            style="-fx-font-size: 22px;"/>

    <Button
            text="Back to Login"
            onAction="#handleBackToLogin"/>

    <Button text="Open Cat Dex"
            onAction="#openCatDex"/>
</VBox>