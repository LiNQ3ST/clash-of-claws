<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
  fx:controller="creature.StorageController"
  alignment="CENTER"
  prefWidth="900"
  prefHeight="550"
  styleClass="creature-root"
  stylesheets="@creature.css">

    <VBox spacing="14"
      maxWidth="860"
      maxHeight="510"
      styleClass="creature-panel">

        <Label text="Cat Storage"
          styleClass="creature-title" />

        <Label text="Move owned cats between your party and storage."
          styleClass="creature-subtitle" />

        <HBox spacing="20"
          VBox.vgrow="ALWAYS">

            <VBox spacing="8"
              prefWidth="410"
              HBox.hgrow="ALWAYS">

                <Label fx:id="partyCountLabel"
                  text="Party: 0 / 4"
                  styleClass="section-title" />

                <ListView fx:id="partyListView"
                  fixedCellSize="100"
                  styleClass="cat-list"
                  VBox.vgrow="ALWAYS" />

            </VBox>

            <VBox spacing="8"
              prefWidth="410"
              HBox.hgrow="ALWAYS">

                <Label fx:id="storageCountLabel"
                  text="Storage: 0"
                  styleClass="section-title" />

                <ListView fx:id="storageListView"
                  fixedCellSize="100"
                  styleClass="cat-list"
                  VBox.vgrow="ALWAYS" />

            </VBox>

        </HBox>

        <HBox spacing="10">

            <Button fx:id="moveToPartyButton"
              text="Move to Party"
              onAction="#handleMoveToParty"
              styleClass="primary-button" />

            <Button text="Move to Storage"
              onAction="#handleMoveToStorage"
              styleClass="primary-button" />

        </HBox>

        <Label fx:id="statusLabel"
          text="Select a cat."
          styleClass="creature-status" />

        <HBox spacing="10">

            <Button text="View Party"
              onAction="#handleParty"
              styleClass="primary-button" />

            <Button text="Back to Town"
              onAction="#handleBack"
              styleClass="primary-button" />

        </HBox>

    </VBox>

</VBox>
