<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<VBox xmlns:fx="http://javafx.com/fxml"
  fx:controller="creature.CatDexController"
  alignment="CENTER"
  prefWidth="900"
  prefHeight="550"
  styleClass="creature-root"
  stylesheets="@creature.css">

    <VBox spacing="14"
      maxWidth="840"
      maxHeight="500"
      styleClass="creature-panel">

        <Label text="CatDex"
          styleClass="creature-title" />

        <Label text="Every cat you have encountered."
          styleClass="creature-subtitle" />

        <ListView fx:id="catListView"
          fixedCellSize="100"
          styleClass="cat-list"
          VBox.vgrow="ALWAYS" />

        <Label fx:id="statusLabel"
          text="No cats loaded"
          styleClass="creature-status" />

        <HBox alignment="CENTER_LEFT">

            <Button text="Back"
              onAction="#handleBack"
              prefWidth="140"
              styleClass="primary-button" />

            <Region HBox.hgrow="ALWAYS" />

            <Button text="Reset Game"
              onAction="#handleResetCatDex"
              styleClass="danger-button" />

        </HBox>
    </VBox>

</VBox>
