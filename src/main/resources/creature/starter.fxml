<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="creature.StarterController"
      alignment="CENTER"
      spacing="20">

    <padding>
        <Insets top="25"
                right="25"
                bottom="25"
                left="25"/>
    </padding>


    <Label text="Choose Your Starter Cat"
           style="-fx-font-size: 36px; -fx-font-weight: bold;"/>

    <Label text="Choose one of the three cats below."/>


    <HBox alignment="CENTER"
          spacing="30">


        <!-- Cat One -->
        <VBox alignment="CENTER"
              spacing="10"
              prefWidth="250">

            <RadioButton
                    fx:id="catOneButton"
                    text="Choose Cat 1"/>

            <Label
                    fx:id="catOneDetails"
                    wrapText="true"
                    textAlignment="CENTER"/>

        </VBox>


        <!-- Cat Two -->
        <VBox alignment="CENTER"
              spacing="10"
              prefWidth="250">

            <RadioButton
                    fx:id="catTwoButton"
                    text="Choose Cat 2"/>

            <Label
                    fx:id="catTwoDetails"
                    wrapText="true"
                    textAlignment="CENTER"/>

        </VBox>


        <!-- Cat Three -->
        <VBox alignment="CENTER"
              spacing="10"
              prefWidth="250">

            <RadioButton
                    fx:id="catThreeButton"
                    text="Choose Cat 3"/>

            <Label
                    fx:id="catThreeDetails"
                    wrapText="true"
                    textAlignment="CENTER"/>

        </VBox>

    </HBox>


    <Label text="Name Your Cat"
           style="-fx-font-size: 20px; -fx-font-weight: bold;"/>


    <TextField
            fx:id="catNameField"
            promptText="Enter your cat's name"
            maxWidth="300"/>


    <Button
            fx:id="chooseButton"
            text="Choose This Cat"
            prefWidth="220"
            prefHeight="42"
            onAction="#handleChooseStarter"
            style="-fx-font-size: 17px;"/>


    <Label
            fx:id="statusLabel"
            style="-fx-text-fill: red;"/>

</VBox>