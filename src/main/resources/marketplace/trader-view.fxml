<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="marketplace.TraderController"
            prefWidth="960"
            prefHeight="600">

    <top>
        <VBox spacing="6">
            <padding>
                <Insets top="16" right="16" bottom="10" left="16"/>
            </padding>
            <Label text="Clash of Claws - Trader"
                   style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
            <Label fx:id="coinBalanceLabel" text="Your Coins: --"/>
        </VBox>
    </top>

    <center>
        <HBox spacing="16">
            <padding>
                <Insets top="6" right="16" bottom="10" left="16"/>
            </padding>

            <!-- LEFT: items for sale -->
            <VBox spacing="8" prefWidth="500">
                <Label text="Trader Items"
                       style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

                <TableView fx:id="traderItemsTable" prefHeight="300">
                    <columns>
                        <TableColumn fx:id="itemNameColumn" text="Item Name" prefWidth="190"/>
                        <TableColumn fx:id="itemTypeColumn" text="Type" prefWidth="110"/>
                        <TableColumn fx:id="priceColumn" text="Price" prefWidth="80"/>
                        <TableColumn fx:id="stockColumn" text="Stock" prefWidth="80"/>
                    </columns>
                </TableView>

                <Label text="Selected Item Details"
                       style="-fx-font-size: 15px; -fx-font-weight: bold;"/>

                <GridPane hgap="8" vgap="6">
                    <Label text="Name:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <Label fx:id="selectedNameLabel" text="-"
                           GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label text="Type:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <Label fx:id="selectedTypeLabel" text="-"
                           GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="Description:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <Label fx:id="selectedDescriptionLabel"
                           text="Select an item from the table."
                           wrapText="true"
                           maxWidth="330"
                           GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                    <Label text="Price:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                    <Label fx:id="selectedPriceLabel" text="-"
                           GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                    <Label text="Stock:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                    <Label fx:id="selectedStockLabel" text="-"
                           GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                </GridPane>

                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Quantity:"/>
                    <Spinner fx:id="quantitySpinner" editable="true" prefWidth="90"/>
                    <Button text="Buy Item" onAction="#buyItem"/>
                </HBox>
            </VBox>

            <Separator orientation="VERTICAL"/>

            <!-- RIGHT: player's creatures -->
            <VBox spacing="8" prefWidth="390">
                <Label text="Your Creatures"
                       style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

                <ListView fx:id="creatureListView" prefHeight="260"/>

                <Label text="Selected Creature Details"
                       style="-fx-font-size: 15px; -fx-font-weight: bold;"/>

                <GridPane hgap="8" vgap="6">
                    <Label text="Name:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <Label fx:id="creatureNameLabel" text="-"
                           GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label text="Type:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <Label fx:id="creatureTypeLabel" text="-"
                           GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="HP:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <Label fx:id="creatureHpLabel" text="-"
                           GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                    <Label text="Sale Value:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                    <Label fx:id="creatureSaleValueLabel" text="-"
                           GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                </GridPane>

                <Button fx:id="sellCreatureButton"
                        text="Sell Creature"
                        disable="true"
                        onAction="#sellCreature"/>
            </VBox>
        </HBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="8">
            <padding>
                <Insets top="8" right="16" bottom="16" left="16"/>
            </padding>
            <Button text="Refresh" onAction="#refreshAll"/>
            <Button text="Return to Main Menu" onAction="#returnToMainMenu"/>
        </HBox>
    </bottom>
</BorderPane>
