<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:id="traderRoot"
      fx:controller="marketplace.TraderController"
      alignment="CENTER"
      prefWidth="960"
      prefHeight="600"
      styleClass="trader-root"
      stylesheets="@trader.css">

    <VBox spacing="10"
          maxWidth="900"
          maxHeight="540"
          styleClass="trader-panel">

        <!-- ========================================================= -->
        <!-- Header -->
        <!-- ========================================================= -->

        <HBox alignment="CENTER_LEFT"
              spacing="16">

            <VBox spacing="2">

                <Label text="Trader"
                       styleClass="trader-title" />

                <Label text="Buy supplies or sell one of your owned cats."
                       styleClass="trader-subtitle" />

            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <Label fx:id="coinBalanceLabel"
                   text="Your Coins: --"
                   styleClass="coin-badge" />

        </HBox>

        <!-- ========================================================= -->
        <!-- Main Content -->
        <!-- ========================================================= -->

        <HBox spacing="20"
              VBox.vgrow="ALWAYS">

            <!-- ===================================================== -->
            <!-- LEFT SIDE - TRADER ITEMS -->
            <!-- ===================================================== -->

            <VBox spacing="6"
                  prefWidth="510"
                  HBox.hgrow="ALWAYS">

                <Label text="Trader Items"
                       styleClass="section-title" />

                <!--
                    Fixed height gives enough room for:
                    header + all four default Trader items.
                -->

                <TableView fx:id="traderItemsTable"
                           minHeight="170"
                           prefHeight="170"
                           maxHeight="170"
                           fixedCellSize="30"
                           styleClass="trader-table">

                    <columns>

                        <TableColumn fx:id="itemNameColumn"
                                     text="Item Name"
                                     prefWidth="190" />

                        <TableColumn fx:id="itemTypeColumn"
                                     text="Type"
                                     prefWidth="110" />

                        <TableColumn fx:id="priceColumn"
                                     text="Price"
                                     prefWidth="80" />

                        <TableColumn fx:id="stockColumn"
                                     text="Stock"
                                     prefWidth="75" />

                    </columns>

                </TableView>

                <!-- ================================================= -->
                <!-- Selected Item Details -->
                <!-- ================================================= -->

                <VBox spacing="6"
                      styleClass="detail-card">

                    <Label text="Selected Item Details"
                           styleClass="detail-title" />

                    <!--
                        Compact 3-row layout.
                        This saves vertical space so the table above
                        can remain large enough to display all items.
                    -->

                    <GridPane hgap="8"
                              vgap="4">

                        <!-- Row 0: Name + Type -->

                        <Label text="Name:"
                               styleClass="detail-label"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="0" />

                        <Label fx:id="selectedNameLabel"
                               text="-"
                               styleClass="detail-value"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="0" />

                        <Label text="Type:"
                               styleClass="detail-label"
                               GridPane.columnIndex="2"
                               GridPane.rowIndex="0" />

                        <Label fx:id="selectedTypeLabel"
                               text="-"
                               styleClass="detail-value"
                               GridPane.columnIndex="3"
                               GridPane.rowIndex="0" />

                        <!-- Row 1: Price + Stock -->

                        <Label text="Price:"
                               styleClass="detail-label"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="1" />

                        <Label fx:id="selectedPriceLabel"
                               text="-"
                               styleClass="detail-value"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="1" />

                        <Label text="Stock:"
                               styleClass="detail-label"
                               GridPane.columnIndex="2"
                               GridPane.rowIndex="1" />

                        <Label fx:id="selectedStockLabel"
                               text="-"
                               styleClass="detail-value"
                               GridPane.columnIndex="3"
                               GridPane.rowIndex="1" />

                        <!-- Row 2: Description -->

                        <Label text="Description:"
                               styleClass="detail-label"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="2" />

                        <Label fx:id="selectedDescriptionLabel"
                               text="Select an item from the table."
                               wrapText="true"
                               maxWidth="330"
                               styleClass="detail-value"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="2"
                               GridPane.columnSpan="3" />

                    </GridPane>

                    <!-- Purchase Controls -->

                    <HBox spacing="10"
                          alignment="CENTER_LEFT">

                        <Label text="Quantity:"
                               styleClass="detail-label" />

                        <Spinner fx:id="quantitySpinner"
                                 editable="true"
                                 prefWidth="90"
                                 styleClass="quantity-spinner" />

                        <Button fx:id="buyItemButton"
                                text="Buy Item"
                                onAction="#buyItem"
                                styleClass="primary-button" />

                    </HBox>

                </VBox>

            </VBox>

            <!-- ===================================================== -->
            <!-- RIGHT SIDE - CREATURE SELLING -->
            <!-- ===================================================== -->

            <VBox fx:id="creatureSellingSection"
                  spacing="6"
                  prefWidth="350"
                  HBox.hgrow="ALWAYS">

                <Label text="Your Creatures"
                       styleClass="section-title" />

                <ListView fx:id="creatureListView"
                          minHeight="170"
                          prefHeight="170"
                          maxHeight="170"
                          styleClass="trader-list" />

                <!-- ================================================= -->
                <!-- Selected Creature Details -->
                <!-- ================================================= -->

                <VBox spacing="6"
                      styleClass="detail-card">

                    <Label text="Selected Creature Details"
                           styleClass="detail-title" />

                    <GridPane hgap="8"
                              vgap="4">

                        <!-- Row 0 -->

                        <Label text="Name:"
                               styleClass="detail-label"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="0" />

                        <Label fx:id="creatureNameLabel"
                               text="-"
                               styleClass="detail-value"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="0" />

                        <Label text="Type:"
                               styleClass="detail-label"
                               GridPane.columnIndex="2"
                               GridPane.rowIndex="0" />

                        <Label fx:id="creatureTypeLabel"
                               text="-"
                               styleClass="detail-value"
                               GridPane.columnIndex="3"
                               GridPane.rowIndex="0" />

                        <!-- Row 1 -->

                        <Label text="HP:"
                               styleClass="detail-label"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="1" />

                        <Label fx:id="creatureHpLabel"
                               text="-"
                               styleClass="detail-value"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="1" />

                        <Label text="Sale Value:"
                               styleClass="detail-label"
                               GridPane.columnIndex="2"
                               GridPane.rowIndex="1" />

                        <Label fx:id="creatureSaleValueLabel"
                               text="-"
                               styleClass="detail-value"
                               GridPane.columnIndex="3"
                               GridPane.rowIndex="1" />

                    </GridPane>

                    <Button fx:id="sellCreatureButton"
                            text="Sell Creature"
                            disable="true"
                            onAction="#sellCreature"
                            styleClass="primary-button" />

                </VBox>

            </VBox>

        </HBox>

        <!-- ========================================================= -->
        <!-- Footer -->
        <!-- ========================================================= -->

        <HBox alignment="CENTER_LEFT"
              spacing="10">

            <Button fx:id="returnToMainMenuButton"
                    text="Back to Town"
                    onAction="#returnToMainMenu"
                    prefWidth="150"
                    styleClass="primary-button" />

            <Region HBox.hgrow="ALWAYS" />

            <Button fx:id="refreshTraderButton"
                    text="Restock Trader"
                    onAction="#restockTrader"
                    prefWidth="160"
                    styleClass="primary-button" />

        </HBox>

    </VBox>

</VBox>
