<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="adminarena.ArenaAdminController"
            prefWidth="950.0"
            prefHeight="600.0">

    <top>
        <VBox alignment="CENTER" spacing="5.0">
            <padding>
                <Insets top="15.0"
                        right="15.0"
                        bottom="15.0"
                        left="15.0"/>
            </padding>

            <Label text="Clash of Claws"
                   style="-fx-font-size: 16px;"/>

            <Label text="Arena Administration"
                   style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
        </VBox>
    </top>

    <center>
        <TableView fx:id="arenaTable">
            <columns>
                <TableColumn fx:id="idColumn"
                             text="ID"
                             prefWidth="45.0"/>

                <TableColumn fx:id="nameColumn"
                             text="Arena Name"
                             prefWidth="140.0"/>

                <TableColumn fx:id="townColumn"
                             text="Town"
                             prefWidth="130.0"/>

                <TableColumn fx:id="difficultyColumn"
                             text="Difficulty"
                             prefWidth="100.0"/>

                <TableColumn fx:id="rewardColumn"
                             text="Reward"
                             prefWidth="90.0"/>

                <TableColumn fx:id="activeColumn"
                             text="Active"
                             prefWidth="80.0"/>
            </columns>

            <BorderPane.margin>
                <Insets top="10.0"
                        right="10.0"
                        bottom="10.0"
                        left="15.0"/>
            </BorderPane.margin>
        </TableView>
    </center>

    <right>
        <VBox spacing="10.0" prefWidth="300.0">
            <padding>
                <Insets top="10.0"
                        right="20.0"
                        bottom="10.0"
                        left="15.0"/>
            </padding>

            <Label text="Arena Details"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <Label text="Arena Name"/>
            <TextField fx:id="arenaNameField"
                       promptText="Claw Pit"/>

            <Label text="Town Name"/>
            <TextField fx:id="townNameField"
                       promptText="Whiskerton"/>

            <Label text="Difficulty"/>
            <ComboBox fx:id="difficultyComboBox"
                      promptText="Select difficulty"/>

            <Label text="Reward"/>
            <TextField fx:id="rewardField"
                       promptText="300"/>

            <CheckBox fx:id="activeCheckBox"
                      text="Active"/>

            <HBox spacing="8.0">
                <Button text="Add"
                        onAction="#handleAddArena"/>

                <Button text="Update"
                        onAction="#handleUpdateArena"/>

                <Button text="Delete"
                        onAction="#handleDeleteArena"/>
            </HBox>

            <Button text="Clear Form"
                    onAction="#handleClearForm"/>
        </VBox>
    </right>

</BorderPane>