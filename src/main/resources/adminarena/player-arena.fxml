<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import javafx.geometry.Insets?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="adminarena.PlayerArenaController"
      alignment="CENTER"
      prefWidth="960.0"
      prefHeight="600.0"
      styleClass="arena-root"
      stylesheets="@player-arena.css">

    <VBox spacing="14.0"
          maxWidth="840.0"
          maxHeight="520.0"
          styleClass="arena-panel">

        <Label fx:id="arenaNameLabel"
               text="Choose Your Arena"
               maxWidth="Infinity"
               styleClass="arena-title"/>

        <Label fx:id="townNameLabel"
               text="Select a challenge below"
               maxWidth="Infinity"
               styleClass="arena-subtitle"/>

        <HBox spacing="20.0"
              alignment="CENTER">

            <VBox spacing="10.0"
                  prefWidth="260.0"
                  styleClass="arena-card">

                <Label text="Choose an Arena"
                       maxWidth="Infinity"
                       styleClass="section-title"/>

                <Button text="Whiskerton Claw Pit"
                        onAction="#handleEasyArena"
                        prefWidth="240.0"
                        styleClass="primary-button"/>

                <Button text="Shadow Alley Arena"
                        onAction="#handleMediumArena"
                        prefWidth="240.0"
                        styleClass="primary-button"/>

                <Button text="Royal Paw Coliseum"
                        onAction="#handleHardArena"
                        prefWidth="240.0"
                        styleClass="primary-button"/>

            </VBox>

            <VBox spacing="10.0"
                  prefWidth="220.0"
                  styleClass="arena-card">

                <Label text="Arena Information"
                       maxWidth="Infinity"
                       styleClass="section-title"/>

                <Label text="Difficulty"
                       styleClass="arena-label"/>

                <Label fx:id="difficultyLabel"
                       text="--"
                       styleClass="arena-value"/>

                <Label text="Reward"
                       styleClass="arena-label"/>

                <Label fx:id="rewardLabel"
                       text="-- coins"
                       styleClass="arena-value"/>

            </VBox>

            <VBox spacing="10.0"
                  prefWidth="220.0"
                  styleClass="arena-card">

                <Label text="Your Active Cat"
                       maxWidth="Infinity"
                       styleClass="section-title"/>

                <Label text="Name"
                       styleClass="arena-label"/>

                <Label fx:id="activeCatNameLabel"
                       text="No active cat"
                       styleClass="arena-value"/>

                <Label text="Health"
                       styleClass="arena-label"/>

                <Label fx:id="activeCatHealthLabel"
                       text="HP: --"
                       styleClass="arena-value"/>

            </VBox>

        </HBox>

        <HBox alignment="CENTER" spacing="20.0">

            <padding>
                <Insets top="20.0"
                        right="20.0"
                        bottom="30.0"
                        left="20.0"/>
            </padding>

            <Button fx:id="challengeButton"
                    text="Challenge Arena"
                    onAction="#handleChallengeArena"
                    prefWidth="190.0"
                    styleClass="primary-button"/>

            <Button text="Back to Town"
                    onAction="#handleBackToTown"
                    prefWidth="160.0"
                    styleClass="primary-button"/>

        </HBox>

    </VBox>

</VBox>