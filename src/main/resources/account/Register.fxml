<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>

<BorderPane
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="account.RegisterController"
        prefWidth="960.0"
        prefHeight="540.0">

    <center>
        <VBox
                alignment="CENTER"
                spacing="14.0"
                style="-fx-padding: 12px 40px 18px 40px;">

            <Label
                    text="JOIN THE BATTLE"
                    style="-fx-font-size: 58px;"/>

            <Label
                    text="Create your player account"
                    style="-fx-font-size: 34px;"/>

            <fx:include
                    fx:id="credentialFields"
                    source="CredentialFields.fxml"/>

            <HBox
                    alignment="CENTER"
                    spacing="18.0">

                <Label
                        text="Confirm:"
                        style="-fx-font-size: 30px;
                               -fx-min-width: 185px;
                               -fx-alignment: center-right;"/>

                <StackPane
                        prefWidth="510.0"
                        prefHeight="46.0">

                    <PasswordField
                            fx:id="confirmationField"
                            prefWidth="510.0"
                            prefHeight="46.0"
                            style="-fx-font-size: 22px;
                   -fx-padding: 0 145 0 8;"/>

                    <TextField
                            fx:id="visibleConfirmationField"
                            visible="false"
                            managed="false"
                            prefWidth="510.0"
                            prefHeight="46.0"
                            style="-fx-font-size: 22px;
                   -fx-padding: 0 145 0 8;"/>

                    <CheckBox
                            fx:id="showConfirmationCheckBox"
                            text="Show Password"
                            onAction="#handleShowConfirmation"
                            StackPane.alignment="CENTER_RIGHT"
                            style="-fx-font-size: 14px;
                   -fx-padding: 0 10 0 0;"/>
                </StackPane>
            </HBox>

            <Label
                    fx:id="errorLabel"
                    minHeight="24.0"
                    wrapText="true"
                    style="-fx-font-size: 18px;-fx-text-fill: #9b0303;"/>

            <Button
                    text="Create Account"
                    prefWidth="220.0"
                    prefHeight="46.0"
                    onAction="#handleCreateAccount"
                    style="-fx-font-size: 22px;"/>

            <Button
                    text="Back"
                    prefWidth="185.0"
                    prefHeight="46.0"
                    onAction="#handleBack"
                    style="-fx-font-size: 22px;"/>

        </VBox>
    </center>

</BorderPane>