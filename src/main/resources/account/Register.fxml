<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="account.RegisterController"
        prefWidth="960.0"
        prefHeight="600.0"
        stylesheets="@account.css"
        styleClass="account-root">

    <center>
        <VBox
                alignment="CENTER"
                spacing="14.0"
                maxWidth="700.0"
                styleClass="poster-panel">

            <Label
                    text="JOIN THE BATTLE"
                    styleClass="poster-title"/>

            <Label
                    text="CREATE YOUR PLAYER ACCOUNT"
                    styleClass="poster-subtitle"/>

            <fx:include
                    fx:id="credentialFields"
                    source="CredentialFields.fxml"/>

            <HBox styleClass="credential-row">

                <Label
                        text="Confirm Password:"
                        styleClass="credential-label"/>

                <StackPane
                        prefWidth="420.0"
                        prefHeight="46.0">

                    <PasswordField
                            fx:id="confirmationField"
                            styleClass="credential-input"/>

                    <TextField
                            fx:id="visibleConfirmationField"
                            visible="false"
                            managed="false"
                            styleClass="credential-input"/>

                    <CheckBox
                            fx:id="showConfirmationCheckBox"
                            text="Show"
                            onAction="#handleShowConfirmation"
                            StackPane.alignment="CENTER_RIGHT"
                            styleClass="show-password"/>

                </StackPane>
            </HBox>

            <Label
                    fx:id="errorLabel"
                    minHeight="24.0"
                    wrapText="true"
                    styleClass="validation-label"/>

            <Button
                    text="CREATE ACCOUNT"
                    prefWidth="220.0"
                    prefHeight="46.0"
                    onAction="#handleCreateAccount"
                    styleClass="primary-button"/>

            <Button
                    text="BACK TO LOGIN"
                    prefWidth="220.0"
                    prefHeight="46.0"
                    onAction="#handleBack"
                    styleClass="secondary-button"/>

        </VBox>
    </center>

</BorderPane>
