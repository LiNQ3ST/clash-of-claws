<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="account.OptionsController"
        prefWidth="960.0"
        prefHeight="600.0"
        stylesheets="@account.css"
        styleClass="account-root">

    <center>
        <VBox
                alignment="CENTER"
                spacing="10.0"
                maxWidth="700.0"
                styleClass="poster-panel"
                style="-fx-padding: 18 32 20 32;">

            <Label
                    text="OPTIONS"
                    styleClass="poster-title"/>

            <Label
                    text="ACCOUNT SETTINGS"
                    styleClass="poster-subtitle"/>

            <HBox styleClass="credential-row">
                <Label
                        text="Current Password:"
                        styleClass="credential-label"/>

                <PasswordField
                        fx:id="currentPasswordField"
                        styleClass="credential-input"/>
            </HBox>

            <HBox styleClass="credential-row">
                <Label
                        text="New Password:"
                        styleClass="credential-label"/>

                <PasswordField
                        fx:id="newPasswordField"
                        styleClass="credential-input"/>
            </HBox>

            <HBox styleClass="credential-row">
                <Label
                        text="Confirm Password:"
                        styleClass="credential-label"/>

                <PasswordField
                        fx:id="confirmationField"
                        styleClass="credential-input"/>
            </HBox>

            <Label
                    fx:id="messageLabel"
                    minHeight="22.0"
                    wrapText="true"
                    styleClass="validation-label"/>

            <Button
                    text="UPDATE PASSWORD"
                    prefWidth="220.0"
                    onAction="#handleUpdatePassword"
                    styleClass="primary-button"/>

            <HBox
                    alignment="CENTER"
                    spacing="30.0">

                <Button
                        text="BACK TO TOWN"
                        onAction="#handleBack"
                        styleClass="secondary-button"/>

                <Button
                        text="LOG OUT"
                        onAction="#handleLogout"
                        styleClass="secondary-button"/>
            </HBox>
            <Button
                    text="EXIT GAME"
                    prefWidth="220.0"
                    onAction="#handleExitGame"
                    styleClass="secondary-button"/>

            <Button
                    text="DELETE ACCOUNT"
                    prefWidth="220.0"
                    onAction="#handleDeleteAccount"
                    styleClass="primary-button"
                    style="-fx-background-color: #6d2626;
                           -fx-text-fill: #ffe1c7;
                           -fx-border-color: #3f2416, #c98568;"/>

        </VBox>
    </center>

</BorderPane>