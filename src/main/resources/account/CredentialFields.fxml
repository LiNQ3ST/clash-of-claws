<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>

<VBox
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="account.CredentialFieldsController"
        spacing="18.0">

    <HBox
            alignment="CENTER"
            spacing="18.0">

        <Label
                text="Username:"
                style="-fx-font-size: 30px;
                       -fx-min-width: 185px;
                       -fx-alignment: center-right;"/>

        <TextField
                fx:id="usernameField"
                prefWidth="510.0"
                prefHeight="46.0"
                style="-fx-font-size: 22px;"/>
    </HBox>

    <HBox
            alignment="CENTER"
            spacing="18.0">

        <Label
                text="Password:"
                style="-fx-font-size: 30px;
                       -fx-min-width: 185px;
                       -fx-alignment: center-right;"/>
        <StackPane
                prefWidth="510.0"
                prefHeight="46.0">

            <PasswordField
                    fx:id="passwordField"
                    prefWidth="510.0"
                    prefHeight="46.0"
                    style="-fx-font-size: 22px;
                   -fx-padding: 0 145 0 8;"/>

            <TextField
                    fx:id="visiblePasswordField"
                    visible="false"
                    managed="false"
                    prefWidth="510.0"
                    prefHeight="46.0"
                    style="-fx-font-size: 22px;
                   -fx-padding: 0 145 0 8;"/>

            <CheckBox
                    fx:id="showPasswordCheckBox"
                    text="Show Password"
                    onAction="#handleShowPassword"
                    StackPane.alignment="CENTER_RIGHT"
                    style="-fx-font-size: 14px;
                   -fx-padding: 0 10 0 0;"/>
        </StackPane>
    </HBox>

</VBox>