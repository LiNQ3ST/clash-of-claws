<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="account.CredentialFieldsController"
        spacing="18.0">

    <HBox
            alignment="CENTER"
            spacing="18.0">

        <Label
                text="Username:"
                style="-fx-font-size: 30px;
                       -fx-min-width: 185px;
                       -fx-alignment: center-right;"/>

        <TextField
                fx:id="usernameField"
                prefWidth="510.0"
                prefHeight="46.0"
                style="-fx-font-size: 22px;"/>
    </HBox>

    <HBox
            alignment="CENTER"
            spacing="18.0">

        <Label
                text="Password:"
                style="-fx-font-size: 30px;
                       -fx-min-width: 185px;
                       -fx-alignment: center-right;"/>

        <PasswordField
                fx:id="passwordField"
                prefWidth="510.0"
                prefHeight="46.0"
                style="-fx-font-size: 22px;"/>
    </HBox>

</VBox>