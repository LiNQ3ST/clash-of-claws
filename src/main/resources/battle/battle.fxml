<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Ellipse?>

<BorderPane
        fx:id="battleRoot"
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="battle.BattleController"
        prefWidth="960.0"
        prefHeight="600.0"
        styleClass="battle-root"
        stylesheets="@battle.css">

  <center>
    <VBox
            alignment="CENTER"
            spacing="12.0"
            maxWidth="900.0"
            translateY="8.0">

      <padding>
        <Insets
                top="20.0"
                right="35.0"
                bottom="10.0"
                left="35.0"/>
      </padding>

      <GridPane
              alignment="CENTER"
              hgap="55.0"
              vgap="20.0"
              maxWidth="820.0">

        <columnConstraints>
          <ColumnConstraints
                  percentWidth="50.0"
                  halignment="CENTER"
                  hgrow="ALWAYS"/>

          <ColumnConstraints
                  percentWidth="50.0"
                  halignment="CENTER"
                  hgrow="ALWAYS"/>
        </columnConstraints>

        <!-- Opponent information -->
        <VBox
                alignment="CENTER_LEFT"
                spacing="8.0"
                minWidth="220.0"
                maxWidth="300.0"
                GridPane.columnIndex="0"
                GridPane.rowIndex="0"
                styleClass="battle-card">

          <Label
                  fx:id="opponentNameLabel"
                  text="Opponent Cat"
                  styleClass="battle-name"/>

          <Label
                  fx:id="opponentHealthLabel"
                  text="HP: 100/100"
                  styleClass="battle-health"/>

        </VBox>

        <!-- Opponent cat -->
        <StackPane
                minWidth="220.0"
                minHeight="145.0"
                GridPane.columnIndex="1"
                GridPane.rowIndex="0">

          <Ellipse
                  radiusX="72.0"
                  radiusY="18.0"
                  translateY="55.0"
                  mouseTransparent="true"
                  styleClass="cat-shadow"/>

          <ImageView
                  fx:id="opponentCatImage"
                  fitWidth="145.0"
                  fitHeight="145.0"
                  preserveRatio="true"
                  smooth="false"
                  pickOnBounds="true"
                  onMouseClicked="#handleOpponentDebugClick"/>

        </StackPane>

        <!-- Player cat -->
        <StackPane
                minWidth="220.0"
                minHeight="145.0"
                GridPane.columnIndex="0"
                GridPane.rowIndex="1">

          <Ellipse
                  radiusX="72.0"
                  radiusY="18.0"
                  translateY="55.0"
                  mouseTransparent="true"
                  styleClass="cat-shadow"/>

          <ImageView
                  fx:id="playerCatImage"
                  fitWidth="145.0"
                  fitHeight="145.0"
                  preserveRatio="true"
                  smooth="false"/>

        </StackPane>

        <!-- Player information -->
        <VBox
                alignment="CENTER_LEFT"
                spacing="8.0"
                minWidth="220.0"
                maxWidth="300.0"
                GridPane.columnIndex="1"
                GridPane.rowIndex="1"
                styleClass="battle-card">

          <Label
                  fx:id="playerNameLabel"
                  text="Player Cat"
                  styleClass="battle-name"/>

          <Label
                  fx:id="playerHealthLabel"
                  text="HP: 100/100"
                  styleClass="battle-health"/>

        </VBox>

      </GridPane>

      <!-- Battle message -->
      <StackPane
              fx:id="messageBox"
              minWidth="760.0"
              prefWidth="760.0"
              maxWidth="760.0"
              minHeight="100.0"
              prefHeight="100.0"
              maxHeight="100.0"
              styleClass="battle-message-box">

        <Label
                fx:id="battleMessageLabel"
                text="Battle has begun!"
                wrapText="true"
                maxWidth="700.0"
                mouseTransparent="true"
                StackPane.alignment="CENTER_LEFT"
                styleClass="battle-message"/>

        <Label
                fx:id="messageAdvanceIndicator"
                text="▼"
                visible="false"
                mouseTransparent="true"
                StackPane.alignment="BOTTOM_RIGHT"
                style="-fx-font-size: 14px;
                 -fx-font-weight: bold;"/>

        <Button
                fx:id="messageClickButton"
                prefWidth="760.0"
                prefHeight="100.0"
                minWidth="760.0"
                minHeight="100.0"
                maxWidth="760.0"
                maxHeight="100.0"
                focusTraversable="false"
                onAction="#handleMessageClick"
                style="-fx-background-color: transparent;
                 -fx-border-color: transparent;
                 -fx-cursor: hand;"/>

      </StackPane>

    </VBox>
  </center>

  <bottom>
    <StackPane
            fx:id="menuStackPane"
            prefWidth="960.0"
            maxWidth="Infinity"
            prefHeight="150.0"
            minHeight="150.0"
            maxHeight="150.0"
            styleClass="battle-menu-panel">

      <padding>
        <Insets
                top="10.0"
                right="20.0"
                bottom="10.0"
                left="20.0"/>
      </padding>

      <!-- Main battle menu -->
      <HBox
              fx:id="actionMenu"
              alignment="CENTER"
              spacing="20.0">

        <Button
                fx:id="attackButton"
                text="Attack"
                prefWidth="140.0"
                styleClass="primary-button"
                onAction="#handleAttack"/>

        <Button
                fx:id="itemActionButton"
                text="Bag"
                prefWidth="140.0"
                styleClass="primary-button"
                onAction="#handleBag"/>

        <Button
                fx:id="runButton"
                text="Run"
                prefWidth="140.0"
                styleClass="primary-button"
                onAction="#handleRun"/>

        <Button
                fx:id="switchButton"
                text="Switch"
                prefWidth="140.0"
                styleClass="primary-button"
                onAction="#handleSwitch"/>

      </HBox>

      <VBox
              fx:id="switchMenu"
              alignment="CENTER"
              spacing="5.0"
              visible="false"
              managed="false">

        <Label
                text="Switch Cat"
                styleClass="battle-menu-title"/>

        <GridPane
                alignment="CENTER"
                hgap="10.0"
                vgap="6.0">

          <Button
                  fx:id="switchCatButton1"
                  prefWidth="220.0"
                  styleClass="battle-menu-button"
                  GridPane.columnIndex="0"
                  GridPane.rowIndex="0"
                  onAction="#handleSwitchCat"/>

          <Button
                  fx:id="switchCatButton2"
                  prefWidth="220.0"
                  styleClass="battle-menu-button"
                  GridPane.columnIndex="1"
                  GridPane.rowIndex="0"
                  onAction="#handleSwitchCat"/>

          <Button
                  fx:id="switchCatButton3"
                  prefWidth="220.0"
                  styleClass="battle-menu-button"
                  GridPane.columnIndex="0"
                  GridPane.rowIndex="1"
                  onAction="#handleSwitchCat"/>

          <Button
                  fx:id="switchCatButton4"
                  prefWidth="220.0"
                  styleClass="battle-menu-button"
                  GridPane.columnIndex="1"
                  GridPane.rowIndex="1"
                  onAction="#handleSwitchCat"/>

        </GridPane>

        <Button
                fx:id="switchBackButton"
                text="Back"
                prefWidth="100.0"
                styleClass="battle-menu-button"
                onAction="#handleSwitchBack"/>

      </VBox>

      <!-- Attack menu -->
      <VBox
              fx:id="attackMenu"
              alignment="CENTER"
              spacing="5.0"
              visible="false"
              managed="false">

        <Label
                text="Choose Attack"
                styleClass="battle-menu-title"/>

        <GridPane
                hgap="10.0"
                vgap="6.0"
                alignment="CENTER">

          <Button
                  fx:id="abilityButton1"
                  text="Ability 1"
                  prefWidth="180.0"
                  styleClass="battle-menu-button"
                  GridPane.columnIndex="0"
                  GridPane.rowIndex="0"
                  onAction="#handleAbilityOne"/>

          <Button
                  fx:id="abilityButton2"
                  text="Ability 2"
                  prefWidth="180.0"
                  styleClass="battle-menu-button"
                  GridPane.columnIndex="1"
                  GridPane.rowIndex="0"
                  onAction="#handleAbilityTwo"/>

          <Button
                  fx:id="abilityButton3"
                  text="Ability 3"
                  prefWidth="180.0"
                  styleClass="battle-menu-button"
                  GridPane.columnIndex="0"
                  GridPane.rowIndex="1"
                  onAction="#handleAbilityThree"/>

          <Button
                  fx:id="abilityButton4"
                  text="Ability 4"
                  prefWidth="180.0"
                  styleClass="battle-menu-button"
                  GridPane.columnIndex="1"
                  GridPane.rowIndex="1"
                  onAction="#handleAbilityFour"/>

        </GridPane>

        <Button
                fx:id="attackBackButton"
                text="Back"
                prefWidth="100.0"
                styleClass="battle-menu-button"
                onAction="#handleAttackBack"/>

      </VBox>

      <!-- Bag menu -->
      <VBox
              fx:id="bagMenu"
              alignment="CENTER"
              spacing="8.0"
              visible="false"
              managed="false">

        <Label
                text="Items"
                styleClass="battle-name"/>

        <GridPane
                hgap="10.0"
                vgap="8.0"
                alignment="CENTER">

          <Button
                  fx:id="itemButton1"
                  prefWidth="170.0"
                  styleClass="primary-button"
                  GridPane.columnIndex="0"
                  GridPane.rowIndex="0"
                  onAction="#handleItem"/>

          <Button
                  fx:id="itemButton2"
                  prefWidth="170.0"
                  styleClass="primary-button"
                  GridPane.columnIndex="1"
                  GridPane.rowIndex="0"
                  onAction="#handleItem"/>

          <Button
                  fx:id="itemButton3"
                  prefWidth="170.0"
                  styleClass="primary-button"
                  GridPane.columnIndex="0"
                  GridPane.rowIndex="1"
                  onAction="#handleItem"/>

          <Button
                  fx:id="itemButton4"
                  prefWidth="170.0"
                  styleClass="primary-button"
                  GridPane.columnIndex="1"
                  GridPane.rowIndex="1"
                  onAction="#handleItem"/>

          <Button
                  fx:id="itemButton5"
                  prefWidth="170.0"
                  styleClass="primary-button"
                  GridPane.columnIndex="0"
                  GridPane.rowIndex="2"
                  onAction="#handleItem"/>

          <Button
                  fx:id="itemButton6"
                  prefWidth="170.0"
                  styleClass="primary-button"
                  GridPane.columnIndex="1"
                  GridPane.rowIndex="2"
                  onAction="#handleItem"/>

        </GridPane>

        <Button
                text="Back"
                prefWidth="100.0"
                styleClass="primary-button"
                onAction="#handleBagBack"/>

      </VBox>

      <!-- Wild victory menu -->
      <VBox
              fx:id="wildVictoryMenu"
              alignment="CENTER"
              visible="false"
              managed="false"
              spacing="10.0">

        <Label
                text="Would you like to continue exploring the Wilds?"
                styleClass="battle-name"/>

        <HBox
                alignment="CENTER"
                spacing="12.0">

          <Button
                  text="Continue Exploring"
                  prefWidth="190.0"
                  styleClass="primary-button"
                  onAction="#handleContinueWilds"/>

          <Button
                  text="Return to Town"
                  prefWidth="160.0"
                  styleClass="primary-button"
                  onAction="#handleReturnToTown"/>

        </HBox>

      </VBox>

    </StackPane>
  </bottom>

</BorderPane>