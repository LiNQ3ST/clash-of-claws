<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane
  xmlns="http://javafx.com/javafx"
  xmlns:fx="http://javafx.com/fxml"
  fx:controller="battle.BattleController"
  prefWidth="960.0"
  prefHeight="600.0"
  minWidth="700.0"
  minHeight="520.0">

  <center>
    <VBox alignment="CENTER" spacing="22.0" maxWidth="900.0">
      <padding>
        <Insets top="28.0" right="35.0" bottom="15.0" left="35.0"/>
      </padding>

      <GridPane alignment="CENTER" hgap="55.0" vgap="38.0" maxWidth="820.0">
        <columnConstraints>
          <ColumnConstraints percentWidth="50.0" halignment="CENTER" hgrow="ALWAYS"/>
          <ColumnConstraints percentWidth="50.0" halignment="CENTER" hgrow="ALWAYS"/>
        </columnConstraints>

        <VBox
          alignment="CENTER_LEFT"
          spacing="8.0"
          minWidth="220.0"
          maxWidth="300.0"
          GridPane.columnIndex="0"
          GridPane.rowIndex="0"
          style="-fx-border-color: #222222; -fx-border-width: 2; -fx-border-radius: 5; -fx-background-color: white; -fx-background-radius: 5; -fx-padding: 14;">

          <Label
            fx:id="opponentNameLabel"
            text="Opponent Cat"
            style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

          <Label
            fx:id="opponentHealthLabel"
            text="HP: 100/100"
            style="-fx-font-size: 14px;"/>
        </VBox>

        <StackPane
          minWidth="220.0"
          minHeight="110.0"
          GridPane.columnIndex="1"
          GridPane.rowIndex="0">
          <Label text="[Opponent Cat]" style="-fx-font-size: 16px;"/>
        </StackPane>

        <StackPane
          minWidth="220.0"
          minHeight="110.0"
          GridPane.columnIndex="0"
          GridPane.rowIndex="1">
          <Label text="[Player Cat]" style="-fx-font-size: 16px;"/>
        </StackPane>

        <VBox
          alignment="CENTER_LEFT"
          spacing="8.0"
          minWidth="220.0"
          maxWidth="300.0"
          GridPane.columnIndex="1"
          GridPane.rowIndex="1"
          style="-fx-border-color: #222222; -fx-border-width: 2; -fx-border-radius: 5; -fx-background-color: white; -fx-background-radius: 5; -fx-padding: 14;">

          <Label
            fx:id="playerNameLabel"
            text="Player Cat"
            style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

          <Label
            fx:id="playerHealthLabel"
            text="HP: 100/100"
            style="-fx-font-size: 14px;"/>
        </VBox>
      </GridPane>

      <StackPane
        fx:id="messageBox"
        minHeight="78.0"
        maxWidth="760.0"
        onMouseClicked="#handleMessageClick"
        style="-fx-border-color: #222222; -fx-border-width: 2; -fx-border-radius: 5; -fx-background-color: white; -fx-background-radius: 5; -fx-padding: 14; -fx-cursor: hand;">

        <Label
          fx:id="battleMessageLabel"
          text="Battle has begun!"
          wrapText="true"
          maxWidth="700.0"
          StackPane.alignment="CENTER_LEFT"
          style="-fx-font-size: 15px;"/>

        <Label
          fx:id="messageAdvanceIndicator"
          text="▼"
          visible="false"
          mouseTransparent="true"
          StackPane.alignment="BOTTOM_RIGHT"
          style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
      </StackPane>
    </VBox>
  </center>

  <bottom>
    <StackPane fx:id="menuStackPane" prefHeight="135.0" minHeight="125.0">
      <padding>
        <Insets top="10.0" right="20.0" bottom="20.0" left="20.0"/>
      </padding>

      <HBox fx:id="actionMenu" alignment="CENTER" spacing="20.0">
        <Button text="Attack" prefWidth="140.0" onAction="#handleAttack"/>
        <Button text="Bag" prefWidth="140.0" onAction="#handleBag"/>
        <Button fx:id="runButton" text="Run" prefWidth="140.0" onAction="#handleRun"/>
      </HBox>

      <VBox
        fx:id="attackMenu"
        alignment="CENTER"
        spacing="8.0"
        visible="false"
        managed="false">

        <Label text="Choose Attack"/>

        <GridPane hgap="10.0" vgap="8.0" alignment="CENTER">
          <Button
            fx:id="abilityButton1"
            text="Ability 1"
            prefWidth="150.0"
            GridPane.columnIndex="0"
            GridPane.rowIndex="0"
            onAction="#handleAbilityOne"/>
          <Button
            fx:id="abilityButton2"
            text="Ability 2"
            prefWidth="150.0"
            GridPane.columnIndex="1"
            GridPane.rowIndex="0"
            onAction="#handleAbilityTwo"/>
          <Button
            fx:id="abilityButton3"
            text="Ability 3"
            prefWidth="150.0"
            GridPane.columnIndex="0"
            GridPane.rowIndex="1"
            onAction="#handleAbilityThree"/>
          <Button
            fx:id="abilityButton4"
            text="Ability 4"
            prefWidth="150.0"
            GridPane.columnIndex="1"
            GridPane.rowIndex="1"
            onAction="#handleAbilityFour"/>
        </GridPane>

        <Button fx:id="attackBackButton"
          text="Back"
          prefWidth="100.0"
          onAction="#handleAttackBack"/>
      </VBox>

      <VBox
        fx:id="bagMenu"
        alignment="CENTER"
        spacing="8.0"
        visible="false"
        managed="false">

        <Label text="Items"/>
        <Button fx:id="itemButton1" onAction="#handleItem"/>
        <Button fx:id="itemButton2" onAction="#handleItem"/>
        <Button fx:id="itemButton3" onAction="#handleItem"/>
        <Button fx:id="itemButton4" onAction="#handleItem"/>
        <Button fx:id="itemButton5" onAction="#handleItem"/>
        <Button fx:id="itemButton6" onAction="#handleItem"/>
        <Button fx:id="bagBackButton"
          text="Back"
          prefWidth="100.0"
          onAction="#handleBagBack"/>
      </VBox>

      <VBox fx:id="wildVictoryMenu"
        visible="false"
        managed="false"
        spacing="8">

        <Label text="Would you like to continue exploring the Wilds?"/>

        <Button text="Continue Exploring"
          onAction="#handleContinueWilds"/>

        <Button text="Return to Town"
          onAction="#handleReturnToTown"/>

      </VBox>

    </StackPane>
  </bottom>
</BorderPane>
